        if age > timedelta(days=self.max_verification_age_days) and not allow_stale:
            raise SimulationError(
                f"fee schedule verification is stale by {age.days} days; fail closed"
            )

    def tier_for(self, effective_30d_volume_usd: Decimal) -> FeeTier:
        volume = dec(effective_30d_volume_usd)
        if volume < 0:
            raise SimulationError("rolling volume cannot be negative")
        selected = self.tiers[0]
        for tier in self.tiers:
            if volume >= tier.minimum_30d_volume_usd:
                selected = tier
            else:
                break
        return selected

    def rate(
        self,
        liquidity: Liquidity,
        effective_30d_volume_usd: Decimal,
        as_of: datetime,
        *,
        allow_stale: bool = False,
    ) -> Decimal:
        self.assert_usable(as_of, allow_stale=allow_stale)
        return self.tier_for(effective_30d_volume_usd).rate(liquidity)

    def to_dict(self) -> dict[str, object]:
        return canonicalize(
            {
                "venue": self.venue,
                "schedule_id": self.schedule_id,
                "effective_from_utc": self.effective_from_utc,
                "verified_at_utc": self.verified_at_utc,
                "source": self.source,
                "credited_asset_fee": self.credited_asset_fee,
                "max_verification_age_days": self.max_verification_age_days,
                "tiers": [tier.__dict__ for tier in self.tiers],
            }
        )



            optimism = 16
        elif regime == "ADVERSE":
            spread = Decimal(rng.choice((6, 8, 12)))
            first_qty = Decimal("0.000025")
            optimism = 35
        else:
            spread = Decimal(rng.choice((3, 4, 5)))
            first_qty = Decimal("0.00020")
            optimism = 10

        true_move_bps = Decimal(rng.choice((-70, -40, -15, 10, 25, 45, 70, 100, 140)))
        noise_bps = Decimal(rng.randint(-18, 18))
        signal_bps = true_move_bps + Decimal(optimism) + noise_bps
        entry = make_book(
            mid=mid,
            spread_bps=spread,
            first_level_quantity=first_qty,
            timestamp=timestamp,
            source=f"synthetic:{regime}:entry:{index}",
        )
        exit_mid = mid * (D1 + true_move_bps / BPS)
        exit_spread = spread + Decimal(rng.choice((-1, 0, 1, 2)))
        exit_spread = max(exit_spread, Decimal("1"))
        exit_book = make_book(
            mid=exit_mid,
            spread_bps=exit_spread,
            first_level_quantity=first_qty,
            timestamp=timestamp + timedelta(seconds=30),
            source=f"synthetic:{regime}:exit:{index}",
        )

        # Approximate requested quantity only to size the deterministic queue tape.
        requested = quote_budget / entry.best_bid
        if regime == "ADVERSE":
            entry_fill_chance = 85 if true_move_bps < 0 else 25
            exit_fill_chance = 20 if true_move_bps < 0 else 45
        else:
            entry_fill_chance = 65 if true_move_bps < 0 else 50
            exit_fill_chance = 35 if true_move_bps < 0 else 65
        entry_filled = rng.randrange(100) < entry_fill_chance
        exit_filled = rng.randrange(100) < exit_fill_chance
        entry_fraction = D1 if entry_filled else D0
        exit_fraction = D1 if exit_filled else D0
        episodes.append(
            Episode(
                episode_id=f"SYN-{index:04d}",
                entry_book=entry,
                exit_book=exit_book,
                signal_bps=signal_bps,
                quote_budget=quote_budget,
                maker_entry_events=_maker_events(
                    side=Side.BUY,
                    price=entry.best_bid,
                    queue=entry.bids[0].quantity,
                    requested=requested,
                    fill_fraction=entry_fraction,
                ),
                maker_exit_events=_maker_events(
                    side=Side.SELL,
                    price=exit_book.best_ask,
                    queue=exit_book.asks[0].quantity,
                    requested=requested,
                    fill_fraction=exit_fraction,
                ),
                regime=regime,
            )
        )
        mid = exit_mid
        timestamp += timedelta(minutes=2)
    return episodes


def load_book_fixture(path: Path) -> tuple[OrderBookSnapshot, InstrumentRules]:
    payload = json.loads(path.read_text())
    if not isinstance(payload, Mapping):
        raise SimulationError("fixture root must be an object")
    book_payload = payload.get("orderbook")
    rules_payload = payload.get("instrument_rules")
    if not isinstance(book_payload, Mapping) or not isinstance(rules_payload, Mapping):
        raise SimulationError("fixture must contain orderbook and instrument_rules")
    book = OrderBookSnapshot.from_dict(book_payload)
    rules = InstrumentRules(
        venue=str(rules_payload["venue"]),
        symbol=str(rules_payload["symbol"]),
        base_asset=str(rules_payload["base_asset"]),
        quote_asset=str(rules_payload["quote_asset"]),
        min_order_size=dec(rules_payload["min_order_size"]),
        min_trade_increment=dec(rules_payload["min_trade_increment"]),
        price_increment=dec(rules_payload["price_increment"]),
        quote_increment=dec(rules_payload["quote_increment"]),
        verified_at_utc=parse_time(str(rules_payload["verified_at_utc"])),
        source=str(rules_payload["source"]),
    )
    return book, rules


def live_snapshot_audit(
    *,
    book: OrderBookSnapshot,
    rules: InstrumentRules,
    notionals: Sequence[Decimal],
    effective_volume: Decimal = D0,
) -> dict[str, object]:
    schedule = alpaca_crypto_fee_schedule()
    tier = schedule.tier_for(effective_volume)
    maker_rate = tier.rate(Liquidity.MAKER)
    taker_rate = tier.rate(Liquidity.TAKER)
    rows: list[dict[str, object]] = []
    for notional in notionals:
        increment = fee_compatible_increment(rules.min_trade_increment, taker_rate)
        quantity = quantity_for_quote_budget(book, dec(notional), increment)
        entry = execute_taker(
            book=book,
            rules=rules,
            side=Side.BUY,
            quantity=quantity,
            schedule=schedule,
            effective_30d_volume_usd=effective_volume,
        )
        exit_fill = execute_taker(
            book=book,
            rules=rules,
            side=Side.SELL,
            quantity=entry.base_delta,
            schedule=schedule,
            effective_30d_volume_usd=effective_volume,
        )
        episode = Episode(
            episode_id=f"LIVE-AUDIT-{decimal_text(notional)}",
            entry_book=book,
            exit_book=replace(book, timestamp_utc=book.timestamp_utc + timedelta(microseconds=1)),
            signal_bps=D0,
            quote_budget=dec(notional),
            regime="CAPTURED_LIVE_BOOK_IMMEDIATE_ROUND_TRIP",
        )
        decision = Decision(
            route=Route.TAKER_TAKER,
            signal_bps=D0,
            calibrated_signal_bps=D0,
            predicted_total_cost_bps=D0,
            predicted_net_bps=D0,
            expected_utility_bps=D0,
            fee_floor_bps=flat_round_trip_fee_burden_bps(taker_rate, taker_rate),
            execution_cost_bps=D0,
            uncertainty_buffer_bps=D0,
            maker_entry_fill_probability=D0,
            maker_exit_fill_probability=D0,
            witnesses=("AUDIT_FORCED_ROUTE",),
        )
        receipt = close_round_trip(
            episode=episode,
            decision=decision,
            entry_fill=entry,
            exit_fills=(exit_fill,),
            previous_receipt_hash="LIVE_SNAPSHOT_AUDIT_GENESIS",
        )
        loss_bps = -receipt.realized_pnl_quote / entry.gross_quote * BPS
        rows.append(
            canonicalize(
                {
                    "quote_budget": notional,
                    "gross_entry_notional": entry.gross_quote,
                    "gross_entry_quantity": entry.filled_quantity,
                    "net_received_quantity_after_buy_fee": entry.base_delta,
                    "entry_vwap": entry.vwap,
                    "entry_depth_slippage_quote": entry.depth_slippage_quote,
                    "exit_vwap": exit_fill.vwap,
                    "exit_depth_slippage_quote": exit_fill.depth_slippage_quote,
                    "realized_flat_round_trip_pnl_quote": receipt.realized_pnl_quote,
                    "realized_flat_round_trip_loss_bps": loss_bps,
                    "closure_residual_quote": receipt.closure_residual_quote,
                }
            )
        )
    return canonicalize(
        {
            "schema_version": SCHEMA_VERSION,
            "audit_kind": "CAPTURED_LIVE_ORDER_BOOK_COUNTERFACTUAL",
            "book_timestamp_utc": book.timestamp_utc,
            "book_hash": book.book_hash,
            "best_bid": book.best_bid,
            "best_ask": book.best_ask,
            "midpoint": book.midpoint,
            "spread_bps": book.spread_bps,
            "fee_tier": tier.name,
            "maker_rate": maker_rate,
            "taker_rate": taker_rate,
            "maker_flat_round_trip_fee_floor_bps": flat_round_trip_fee_burden_bps(maker_rate, maker_rate),
            "maker_entry_taker_exit_fee_floor_bps": flat_round_trip_fee_burden_bps(maker_rate, taker_rate),
            "taker_flat_round_trip_fee_floor_bps": flat_round_trip_fee_burden_bps(taker_rate, taker_rate),
            "declared_target_bps": Decimal("20"),
            "declared_target_clears_maker_maker_fee_floor": Decimal("20") > flat_round_trip_fee_burden_bps(maker_rate, maker_rate),
            "rows": rows,
            "boundary": NO_EXECUTION_BOUNDARY,
        }
    )


def write_run(output: Path, events: Sequence[SimulationEvent], summary: Mapping[str, object]) -> None:
    if output.exists() and any(output.iterdir()):
        raise FileExistsError(f"refusing to overwrite nonempty run directory: {output}")
    output.mkdir(parents=True, exist_ok=True)
    events_path = output / "events.jsonl"
    with events_path.open("w") as sink:
        for event in events:
            sink.write(json.dumps(event.to_dict(), sort_keys=True) + "\n")
    (output / "summary.json").write_text(json.dumps(canonicalize(summary), indent=2, sort_keys=True) + "\n")
    program_path = Path(__file__)
    manifest = {
        "schema_version": SCHEMA_VERSION,
